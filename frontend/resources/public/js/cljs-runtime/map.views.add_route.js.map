(ns map.views.add-route
  (:require [re-frame.core :as rf]
            [reagent.core :as r]
            [map.views.components :as components]))

(defn distinct-by [f coll]
  (let [seen (volatile! #{})]
    (filter (fn [x]
              (let [key (f x)]
                (if (@seen key)
                  false
                  (do (vswap! seen conj key)
                      true))))
            coll)))

(def state (r/atom {:src-iata "" :dst-iata ""}))

(defn route-picker-panel []
  (let [show-picker? @(rf/subscribe [:map/show-route-picker])
        available-routes @(rf/subscribe [:map/available-routes])
        loading? @(rf/subscribe [:map/loading-routes])
        ;; Now available-routes contains AirportCoord objects directly
        airports (if (seq available-routes)
                   (->> available-routes
                        (sort-by :name))
                   [])]
    (when show-picker?
      [:div {:class "fixed top-5 left-5 w-80 bg-white rounded-lg shadow-xl p-5 max-h-[80vh] overflow-y-auto z-[1000]"}
       [:div {:class "flex justify-between items-center mb-4"}
        [:h3 {:class "text-base font-semibold"} "Create New Route"]
        [:button {:on-click #(rf/dispatch [:map/toggle-route-picker])
                  :class "px-3 py-1 bg-gray-500 text-white rounded text-sm hover:bg-gray-600"}
         "Close"]]
       (if loading?
         [:div {:class "text-gray-500"} "Loading airports..."]
         (if (empty? airports)
           [:div {:class "text-gray-500"} "No airports available"]
           [:div {:class "space-y-4"}
            [:select {:value (:src-iata @state)
                      :on-change (fn [e]
                                   (let [value (.-value (.-target e))]
                                     (swap! state assoc :src-iata value)))
                      :class "w-full p-2 border rounded text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500"}
             [:option {:value "" :disabled true} "Select source airport"]
             (for [{:keys [iata name]} airports]
               ^{:key iata}
               [:option {:value iata} (str name " (" iata ")")])]
            [:select {:value (:dst-iata @state)
                      :on-change (fn [e]
                                   (let [value (.-value (.-target e))]
                                     (swap! state assoc :dst-iata value)))
                      :class "w-full p-2 border rounded text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500"}
             [:option {:value "" :disabled true} "Select destination airport"]
             (for [{:keys [iata name]} airports]
               ^{:key iata}
               [:option {:value iata} (str name " (" iata ")")])]
            [:button
             {:on-click (fn []
                          (when (and (seq (:src-iata @state)) (seq (:dst-iata @state)))
                            (rf/dispatch [:map/create-simple-route (:src-iata @state) (:dst-iata @state)])))
              :disabled (or (empty? (:src-iata @state)) (empty? (:dst-iata @state)) loading?)
              :class "w-full px-4 py-2 bg-blue-500 text-white rounded text-sm hover:bg-blue-600 disabled:bg-gray-400"}
             (if loading? "Creating..." "Create Route")]]))
       [components/notification @(rf/subscribe [:map/notification])]])))

(defn saved-routes-panel []
  (let [saved-routes @(rf/subscribe [:map/routes])]
    (when (seq saved-routes)
      [:div {:class "fixed top-20 right-5 w-80 bg-white rounded-lg shadow-xl p-5 max-h-[400px] overflow-y-auto z-[1000]"}
       [:h3 {:class "text-base font-semibold mb-3"} (str "Saved Routes (" (count saved-routes) ")")]
       [:div {:class "space-y-2"}
        (for [route saved-routes]
          ^{:key (str (:srcIata route) "-" (:dstIata route) "-" (:airline route))}
          [components/saved-route-item {:route route}])]])))

(defn route-picker-button []
  (let [show-picker? @(rf/subscribe [:map/show-route-picker])]
    [:button {:on-click #(rf/dispatch [:map/toggle-route-picker])
              :class (str "fixed top-5 left-5 px-4 py-2 rounded text-sm text-white shadow-lg z-[1000] "
                          (if show-picker? "bg-gray-500 hover:bg-gray-600" "bg-blue-500 hover:bg-blue-600"))}
     (if show-picker? "Close Picker" "Create Route")]))
