(ns map.views.search
  (:require [re-frame.core :as rf]))

(defn search-bar []
  (let [search-text @(rf/subscribe [:map/search])]
    [:div {:style {:position "absolute"
                   :top "20px"
                   :left "50%"
                   :transform "translateX(-50%)"
                   :z-index 1000
                   :background "rgba(255,255,255,0.95)"
                   :padding "10px"
                   :border-radius "8px"
                   :box-shadow "0 2px 8px rgba(0,0,0,0.3)"
                   :display "flex"
                   :gap "10px"}}
     [:input {:type "text"
              :placeholder "Search location..."
              :value search-text
              :on-change #(rf/dispatch [:map/update-search (-> % .-target .-value)])
              :on-key-down #(when (= (.-key %) "Enter")
                              (rf/dispatch [:map/search-location search-text]))
              :style {:padding "8px 12px"
                      :border "1px solid #ddd"
                      :border-radius "4px"
                      :font-size "14px"
                      :width "300px"
                      :outline "none"}}]
     [:button {:on-click #(rf/dispatch [:map/search-location search-text])
               :style {:padding "8px 16px"
                       :background "#007bff"
                       :color "white"
                       :border "none"
                       :border-radius "4px"
                       :cursor "pointer"
                       :font-size "14px"
                       :font-weight "500"}}
      "Search"]]))

(defn search-history-panel []
  (let [history @(rf/subscribe [:map/history])]
    (when (seq history)
      [:div {:style {:position "absolute"
                     :top "80px"
                     :right "20px"
                     :z-index 1000
                     :background "rgba(255,255,255,0.95)"
                     :padding "15px"
                     :border-radius "8px"
                     :box-shadow "0 2px 8px rgba(0,0,0,0.3)"
                     :max-width "300px"
                     :max-height "400px"
                     :overflow-y "auto"}}
       [:h3 {:style {:margin "0 0 10px 0"
                     :font-size "16px"
                     :font-weight "600"}}
        "Search History"]
       [:div
        (for [item history]
          ^{:key (:timestamp item)}
          [:div {:style {:padding "8px"
                        :border-bottom "1px solid #eee"
                        :cursor "pointer"}
                 :on-click #(do
                             (rf/dispatch [:map/set-center {:lat (:lat item) :lng (:lng item)}])
                             (rf/dispatch [:map/set-zoom 5]))}
           [:div {:style {:font-weight "500"}} (:location item)]
           [:div {:style {:font-size "12px" :color "#666"}}
            (str (:lat item) ", " (:lng item))]])]])))
